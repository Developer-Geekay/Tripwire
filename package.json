{
  "name": "tripwire",
  "private": true,
  "version": "0.3.1",
  "description": "In-browser UI test runner extension. Tampermonkey ergonomics, Playwright semantics, zero toolchain.",
  "type": "module",
  "scripts": {
    "dev": "vite build --watch",
    "build": "npm run typecheck && vite build",
    "build:dev": "vite build --mode development",
    "typecheck": "tsc --noEmit",
    "package": "node scripts/package.mjs",
    "package:all": "npm run build && npm run package && npm run build:dev && node scripts/package.mjs --dev"
  },
  "dependencies": {
    "monaco-editor": "^0.52.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.287",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "crx": "^5.0.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.7"
  }
}
